pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'Wiem', url: 'https://github.com/user-nermine/DevOps_Project.git'
            }
        }

        stage('Build') {
            steps {
                dir('DevOps_Project/Order/pom.xml') { 
                    script {
                        echo 'Building the Maven project...'
                        bat 'mvn clean install'
                    }
                }
            }
        }
    }
}
